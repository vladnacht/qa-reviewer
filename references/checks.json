{
  "depths": {
    "quick": {
      "viewports": [
        "desktop",
        "mobile"
      ],
      "critical_only": true,
      "baseline": [
        "fn.action.works",
        "fn.perm.access",
        "ui.layout.overlap",
        "ui.content.placeholder",
        "ux.a11y.semantics",
        "bug.net.clean",
        "rsp.layout",
        "rsp.parity.actions"
      ]
    },
    "standard": {
      "viewports": [
        "desktop",
        "tablet",
        "mobile"
      ],
      "critical_only": false
    },
    "exhaustive": {
      "viewports": [
        "small",
        "mobile",
        "tablet",
        "laptop",
        "desktop",
        "wide"
      ],
      "critical_only": false
    }
  },
