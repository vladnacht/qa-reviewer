  "checks": [
    {
      "id": "fn.flow.happy",
      "specialist": "qa-fn-flows",
      "applies": [
        "flow"
      ],
      "per": [
        "viewport"
      ],
      "viewports": [
        "desktop",
        "mobile"
      ],
      "depth": "quick",
      "title": "Le parcours va au bout ; le résultat est visible et persiste après rechargement."
    },
    {
      "id": "fn.action.works",
      "specialist": "qa-fn-flows",
      "applies": [
        "page",
        "modal",
        "form",
        "layout"
      ],
      "when": [
        "actions"
      ],
      "per": [
        "action"
      ],
      "depth": "quick",
      "title": "L'action fait ce que son libellé annonce (destination, effet) ; aucun bouton mort."
    },
    {
      "id": "fn.flow.alternatives",
      "specialist": "qa-fn-flows",
      "applies": [
        "flow"
      ],
      "depth": "standard",
      "title": "Branches du parcours : annuler, revenir, modifier une étape, reprendre plus tard."
    },
    {
